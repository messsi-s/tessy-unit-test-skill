{
  "object": "demo_get_position",
  "default_out": "0",
  "cases": [
    {
      "name": "TC01_ValidF1",
      "desc": "有效档位 F1(3)：返回3并刷新上次有效值",
      "spec": "SW-REQ-017",
      "steps": [
        {
          "values": {
            "Demo_position": 3,
            "demo_get_position::lastValidPos#1": 0,
            "demo_get_position::startupInvalidMaskCnt#1": 0
          },
          "expect": {
            "demo_get_position()": 3,
            "demo_get_position::lastValidPos#1": 3,
            "demo_get_position::startupInvalidMaskCnt#1": 0
          }
        }
      ]
    },
    {
      "name": "TC02_InvalidMaskProgression",
      "desc": "多测试步：无效值连续出现，前两次返回上次有效值并累加掩码，第3次返回当前无效值",
      "spec": "SW-REQ-017",
      "steps": [
        {
          "values": {
            "Demo_position": 15,
            "demo_get_position::lastValidPos#1": 0,
            "demo_get_position::startupInvalidMaskCnt#1": 0
          },
          "expect": {
            "demo_get_position()": 0,
            "demo_get_position::lastValidPos#1": 0,
            "demo_get_position::startupInvalidMaskCnt#1": 1
          }
        },
        {
          "values": {
            "Demo_position": 15,
            "demo_get_position::lastValidPos#1": 0,
            "demo_get_position::startupInvalidMaskCnt#1": 1
          },
          "expect": {
            "demo_get_position()": 0,
            "demo_get_position::lastValidPos#1": 0,
            "demo_get_position::startupInvalidMaskCnt#1": 2
          }
        },
        {
          "values": {
            "Demo_position": 15,
            "demo_get_position::lastValidPos#1": 0,
            "demo_get_position::startupInvalidMaskCnt#1": 2
          },
          "expect": {
            "demo_get_position()": 15,
            "demo_get_position::lastValidPos#1": 0,
            "demo_get_position::startupInvalidMaskCnt#1": 2
          }
        }
      ]
    },
    {
      "name": "TC03_LastValidThenInvalid",
      "desc": "多测试步：先有效(3)刷新上次有效值，随后无效两次返回3，第3次返回15",
      "spec": "SW-REQ-017",
      "steps": [
        {
          "values": {
            "Demo_position": 3,
            "demo_get_position::lastValidPos#1": 0,
            "demo_get_position::startupInvalidMaskCnt#1": 0
          },
          "expect": {
            "demo_get_position()": 3,
            "demo_get_position::lastValidPos#1": 3,
            "demo_get_position::startupInvalidMaskCnt#1": 0
          }
        },
        {
          "values": {
            "Demo_position": 15,
            "demo_get_position::lastValidPos#1": 3,
            "demo_get_position::startupInvalidMaskCnt#1": 0
          },
          "expect": {
            "demo_get_position()": 3,
            "demo_get_position::lastValidPos#1": 3,
            "demo_get_position::startupInvalidMaskCnt#1": 1
          }
        }
      ]
    }
  ]
}
